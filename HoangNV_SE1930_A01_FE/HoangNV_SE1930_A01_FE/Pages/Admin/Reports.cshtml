@page
@model HoangNV_SE1930_A01_FE.Pages.Admin.ReportsModel
@{
    ViewData["Title"] = "Reports & Analytics";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-bar-chart-line-fill text-primary me-2"></i>News Reports & Analytics</h2>
        <p class="text-muted mb-0">Generate statistics on news articles by date period, category, author, and export to Excel (Admin only).</p>
    </div>
    <div>
        <button type="button" class="btn btn-success px-4 shadow-sm" id="btnExportExcel" onclick="exportToExcel()">
            <span id="exportSpinner" class="spinner-border spinner-border-sm d-none me-1" role="status"></span>
            <i class="bi bi-file-earmark-excel-fill me-1"></i> Export Excel (.xlsx)
        </button>
    </div>
</div>

<!-- Date Filter Card -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-4">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-semibold">Start Date (From)</label>
                <input type="date" id="reportStartDate" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold">End Date (To)</label>
                <input type="date" id="reportEndDate" class="form-control" />
            </div>
            <div class="col-md-4">
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-primary flex-grow-1" onclick="generateReport()">
                        <i class="bi bi-funnel-fill me-1"></i> Filter Period
                    </button>
                    <button type="button" class="btn btn-outline-secondary" onclick="resetReportPeriod()">
                        Reset
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 bg-primary text-white p-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-white-50 text-uppercase fw-semibold small">Total Articles</span>
                    <h2 class="display-5 fw-bold mb-0" id="kpiTotal">0</h2>
                </div>
                <div class="bg-white bg-opacity-25 rounded-circle p-3">
                    <i class="bi bi-newspaper fs-2 text-white"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 bg-success text-white p-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-white-50 text-uppercase fw-semibold small">Active (Published)</span>
                    <h2 class="display-5 fw-bold mb-0" id="kpiActive">0</h2>
                </div>
                <div class="bg-white bg-opacity-25 rounded-circle p-3">
                    <i class="bi bi-check-circle-fill fs-2 text-white"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 bg-secondary text-white p-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-white-50 text-uppercase fw-semibold small">Inactive (Draft)</span>
                    <h2 class="display-5 fw-bold mb-0" id="kpiInactive">0</h2>
                </div>
                <div class="bg-white bg-opacity-25 rounded-circle p-3">
                    <i class="bi bi-dash-circle-fill fs-2 text-white"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Breakdown Tables Row -->
<div class="row g-4 mb-4">
    <!-- Category Breakdown Table -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-folder-fill text-primary me-2"></i>Articles by Category</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Category Name</th>
                            <th class="text-center">Total</th>
                            <th class="text-center">Active</th>
                            <th class="text-center pe-4">Inactive</th>
                        </tr>
                    </thead>
                    <tbody id="categoryReportBody">
                        <tr>
                            <td colspan="4" class="text-center py-3 text-muted">No data available.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Author Breakdown Table -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-person-fill text-primary me-2"></i>Articles by Author</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Author Name</th>
                            <th class="text-center">Total</th>
                            <th class="text-center">Active</th>
                            <th class="text-center pe-4">Inactive</th>
                        </tr>
                    </thead>
                    <tbody id="authorReportBody">
                        <tr>
                            <td colspan="4" class="text-center py-3 text-muted">No data available.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Detailed Articles Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-card-checklist text-primary me-2"></i>Detailed Articles List (Sorted by Created Date Descending)
        </h5>
        <span class="badge bg-light text-dark border px-3 py-1" id="reportCountBadge">0 articles</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">ID</th>
                    <th>News Title</th>
                    <th>Category</th>
                    <th>Author</th>
                    <th>Status</th>
                    <th>Created Date</th>
                    <th class="pe-4">Source</th>
                </tr>
            </thead>
            <tbody id="articlesReportBody">
                <tr>
                    <td colspan="7" class="text-center py-4 text-muted">
                        <div class="spinner-border spinner-border-sm text-primary me-2"></div> Loading report data...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            generateReport();
        });

        function resetReportPeriod() {
            document.getElementById('reportStartDate').value = '';
            document.getElementById('reportEndDate').value = '';
            generateReport();
        }

        async function generateReport() {
            const startDate = document.getElementById('reportStartDate').value;
            const endDate = document.getElementById('reportEndDate').value;

            let query = '';
            const params = [];
            if (startDate) params.push(`startDate=${encodeURIComponent(startDate)}`);
            if (endDate) params.push(`endDate=${encodeURIComponent(endDate)}`);
            if (params.length > 0) query = '?' + params.join('&');

            try {
                const response = await apiFetch(`report/statistics${query}`);
                if (response.ok) {
                    const data = await response.json();
                    renderReportData(data);
                } else {
                    showToast('Failed to load report statistics.', 'danger');
                }
            } catch (err) {
                showToast('Error connecting to backend reporting service.', 'danger');
            }
        }

        function renderReportData(data) {
            document.getElementById('kpiTotal').textContent = data.totalArticles || 0;
            document.getElementById('kpiActive').textContent = data.activeArticles || 0;
            document.getElementById('kpiInactive').textContent = data.inactiveArticles || 0;
            document.getElementById('reportCountBadge').textContent = `${data.totalArticles || 0} articles`;

            // Render Categories
            const catBody = document.getElementById('categoryReportBody');
            if (!data.categoryGroups || data.categoryGroups.length === 0) {
                catBody.innerHTML = `<tr><td colspan="4" class="text-center py-3 text-muted">No categories in period.</td></tr>`;
            } else {
                let html = '';
                data.categoryGroups.forEach(cg => {
                    html += `
                        <tr>
                            <td class="ps-4 fw-semibold text-dark">${escapeHtml(cg.categoryName)}</td>
                            <td class="text-center fw-bold text-primary">${cg.articleCount}</td>
                            <td class="text-center text-success">${cg.activeCount}</td>
                            <td class="text-center pe-4 text-secondary">${cg.inactiveCount}</td>
                        </tr>
                    `;
                });
                catBody.innerHTML = html;
            }

            // Render Authors
            const authBody = document.getElementById('authorReportBody');
            if (!data.authorGroups || data.authorGroups.length === 0) {
                authBody.innerHTML = `<tr><td colspan="4" class="text-center py-3 text-muted">No authors in period.</td></tr>`;
            } else {
                let html = '';
                data.authorGroups.forEach(ag => {
                    html += `
                        <tr>
                            <td class="ps-4 fw-semibold text-dark">${escapeHtml(ag.authorName)}</td>
                            <td class="text-center fw-bold text-primary">${ag.articleCount}</td>
                            <td class="text-center text-success">${ag.activeCount}</td>
                            <td class="text-center pe-4 text-secondary">${ag.inactiveCount}</td>
                        </tr>
                    `;
                });
                authBody.innerHTML = html;
            }

            // Render Articles
            const artBody = document.getElementById('articlesReportBody');
            if (!data.articles || data.articles.length === 0) {
                artBody.innerHTML = `<tr><td colspan="7" class="text-center py-4 text-muted">No articles found in this period.</td></tr>`;
            } else {
                let html = '';
                data.articles.forEach(a => {
                    const statusBadge = a.newsStatus
                        ? '<span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Active</span>'
                        : '<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">Inactive</span>';

                    html += `
                        <tr>
                            <td class="ps-4 fw-bold text-secondary">#${a.newsArticleId}</td>
                            <td class="fw-semibold text-dark text-truncate" style="max-width: 300px;" title="${escapeHtml(a.newsTitle)}">${escapeHtml(a.newsTitle)}</td>
                            <td><span class="badge bg-light text-dark border">${escapeHtml(a.categoryName || 'News')}</span></td>
                            <td><small class="fw-semibold">${escapeHtml(a.createdByName || 'Unknown')}</small></td>
                            <td>${statusBadge}</td>
                            <td><small class="text-muted">${formatDate(a.createdDate)}</small></td>
                            <td class="pe-4"><small class="text-muted">${escapeHtml(a.newsSource || 'N/A')}</small></td>
                        </tr>
                    `;
                });
                artBody.innerHTML = html;
            }
        }

        async function exportToExcel() {
            const startDate = document.getElementById('reportStartDate').value;
            const endDate = document.getElementById('reportEndDate').value;

            let query = '';
            const params = [];
            if (startDate) params.push(`startDate=${encodeURIComponent(startDate)}`);
            if (endDate) params.push(`endDate=${encodeURIComponent(endDate)}`);
            if (params.length > 0) query = '?' + params.join('&');

            const btn = document.getElementById('btnExportExcel');
            const spinner = document.getElementById('exportSpinner');
            btn.disabled = true;
            spinner.classList.remove('d-none');

            try {
                const token = getJwtToken();
                const url = `${API_BASE_URL}report/export-excel${query}`;
                const response = await fetch(url, {
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });

                if (response.ok) {
                    const blob = await response.blob();
                    const downloadUrl = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = downloadUrl;
                    a.download = `FUNews_Report_${new Date().toISOString().slice(0,10)}.xlsx`;
                    document.body.appendChild(a);
                    a.click();
                    a.remove();
                    window.URL.revokeObjectURL(downloadUrl);
                    showToast('Excel report downloaded successfully!', 'success');
                } else {
                    showToast('Failed to export Excel report.', 'danger');
                }
            } catch (err) {
                showToast('Error exporting report: ' + err.message, 'danger');
            } finally {
                btn.disabled = false;
                spinner.classList.add('d-none');
            }
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text || '';
            return div.innerHTML;
        }
    </script>
}
